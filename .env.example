# ── 앱 (apps/mobile/.env) : EXPO_PUBLIC_ 만 앱 번들에 포함된다 ──
# 로컬 Supabase(`pnpm db:start`) 값은 `supabase status`로 확인한다.
# Android 에뮬레이터에서 PC의 localhost는 10.0.2.2, 실기기는 PC의 LAN IP로 바꾼다.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# publishable key(sb_publishable_...) 또는 레거시 anon key
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# ── API 서버 (apps/api/.env) : 절대 앱에 넣지 않는다 ──
PORT=8787
SUPABASE_URL=http://127.0.0.1:54321
# secret key(sb_secret_...) 또는 레거시 service_role key
SUPABASE_SERVICE_ROLE_KEY=
# 레거시 HS256 서명 프로젝트에서만 채운다. 비우면 JWKS로 검증한다.
SUPABASE_JWT_SECRET=

# mock이면 Gemini·ElevenLabs를 호출하지 않고 고정 결과를 쓴다(유료 키 없이 개발). 프로덕션 금지.
PROVIDER_MODE=mock

GEMINI_API_KEY=
GEMINI_STORY_MODEL=gemini-3-flash-preview
GEMINI_SAFETY_MODEL=gemini-3.1-flash-lite

ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_STORY_MODEL=eleven_v3
ELEVENLABS_SHORT_MODEL=eleven_flash_v2_5
ELEVENLABS_LONG_MODEL=eleven_multilingual_v2
ELEVENLABS_IMAGE_MODEL=gemini-3.1-flash-image

REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=

# 로컬은 INNGEST_DEV=1로 dev server(`pnpm dev:inngest`)에 붙는다. 배포 환경은 아래 두 키를 채운다.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

EXPO_ACCESS_TOKEN=
SENTRY_DSN=
